# Frontend environment variables
# Anything prefixed VITE_ is exposed to the browser — never put secrets here.

# Public URL of the deployed site (used for canonical URLs and Open Graph)
VITE_SITE_URL=https://tarieciphertech.github.io/shein-with-rejo

# Base URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:5000
