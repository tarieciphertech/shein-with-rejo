# ============ SHEIN with Rejo — backend configuration ============

# Server
PORT=5000
NODE_ENV=development

# --- Database (required) ---
# PostgreSQL connection string. The API will not start without it.
# Local dev example: postgres://postgres:postgres@localhost:5432/shein_with_rejo
DATABASE_URL=

# --- Security (required in production) ---
# Long random string used to sign admin session tokens (e.g. `openssl rand -hex 64`)
JWT_SECRET=
# Comma-separated list of allowed browser origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,https://tarieciphertech.github.io
# Set to true in production so the admin session cookie is only sent over HTTPS
COOKIE_SECURE=false

# --- Admin account ---
# Create the hash with: cd backend && npm run hash-password -- "your-password"
ADMIN_EMAIL=admin@sheinwithrejo.example
ADMIN_PASSWORD_HASH=

# --- File uploads ---
# Directory for local-disk storage. In production prefer object storage (see README).
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
