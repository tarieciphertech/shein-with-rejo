# ============ SHEIN with Rejo — backend configuration ============

# Server
PORT=5000
NODE_ENV=development

# --- Database (required) ---
DATABASE_URL=

# --- Security (required in production) ---
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,https://tarieciphertech.github.io,https://shopwithrejo.co.zw,https://www.shopwithrejo.co.zw
COOKIE_SECURE=false

# --- Admin account ---
ADMIN_EMAIL=admin@sheinwithrejo.example
ADMIN_PASSWORD_HASH=

# --- Screenshot storage ---
# Use local for development; production defaults to Supabase.
STORAGE_DRIVER=local
SUPABASE_URL=
# Server-side secret/service_role key ONLY. Never add this to frontend variables.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=order-screenshots
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- Notifications ---
PUBLIC_SITE_URL=https://shopwithrejo.co.zw
ADMIN_NOTIFICATION_EMAIL=
ADMIN_WHATSAPP_TO=
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_ADMIN_NEW_ORDER_CONTENT_SID=
TWILIO_CUSTOMER_STATUS_CONTENT_SID=
