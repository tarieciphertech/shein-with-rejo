# ============ SHEIN with Rejo — backend configuration ============

# Server
PORT=5000
NODE_ENV=development

# --- Database (required) ---
# PostgreSQL connection string. The API will not start without it.
# Local dev example: postgres://postgres:postgres@localhost:5432/shein_with_rejo
DATABASE_URL=

# --- Security (required in production) ---
# Long random string used to sign admin session tokens (e.g. `openssl rand -hex 64`)
JWT_SECRET=
# Comma-separated list of allowed browser origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,https://tarieciphertech.github.io
# Set to true in production so the admin session cookie is only sent over HTTPS
COOKIE_SECURE=false

# --- Admin account ---
# Create the hash with: cd backend && npm run hash-password -- "your-password"
ADMIN_EMAIL=admin@sheinwithrejo.example
ADMIN_PASSWORD_HASH=

# --- File uploads ---
# Directory for local-disk storage. In production prefer object storage (see README).
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- Notifications ---
# Public site used for direct links in email/WhatsApp notifications.
PUBLIC_SITE_URL=https://tarieciphertech.github.io/shein-with-rejo

# Rejo's notification destinations.
ADMIN_NOTIFICATION_EMAIL=
ADMIN_WHATSAPP_TO=

# Email via Resend REST API. Keep the API key server-side in Render.
# EMAIL_FROM must be an address/domain verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=

# WhatsApp via Twilio. Use E.164 numbers for recipients; the code accepts
# Zimbabwe local numbers such as 078xxxxxxx and converts them to +263xxxxxxx.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional approved WhatsApp template Content SIDs for business-initiated messages.
# Leave blank for sandbox/session testing where free-form Body messages are allowed.
TWILIO_ADMIN_NEW_ORDER_CONTENT_SID=
TWILIO_CUSTOMER_STATUS_CONTENT_SID=
